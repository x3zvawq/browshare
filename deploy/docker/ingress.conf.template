# Rendered by prepare-development-deployment.mjs; no credentials belong in this file.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen __HTTPS_PORT__ ssl;
    server_name __HOSTNAME__;
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;
    set $backend http://backend:3400;
    set $gateway http://gateway:3481;

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
    }
    location = /signal/ {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }
    # Gateway and Worker use authenticated internal APIs through the TLS origin.
    location /internal/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }
    location = /health/ready { proxy_pass $backend; }
    location = /health/live { proxy_pass $backend; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control 'public, max-age=31536000, immutable';
    }
    location = /index.html {
        add_header Cache-Control 'no-store' always;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control 'no-store' always;
    }
}

# Only the Compose network can reach the authenticated Gateway readiness endpoint.
server {
    listen 8444 ssl;
    server_name __HOSTNAME__;
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    set $gateway_health http://gateway:3482;
    location = /health/ready { proxy_pass $gateway_health; }
    location = /metrics { proxy_pass $gateway_health; }
    location / { return 404; }
}
