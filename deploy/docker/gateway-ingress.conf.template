# Rendered by prepare-gateway-deployment.mjs; no credentials belong in this file.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen __HTTPS_LISTEN_PORT__ ssl;
    server_name __HOSTNAME__;
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    set $gateway http://gateway:3481;
    set $gateway_health http://gateway:3482;

    location = /signal/ {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Cookie '';
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }
    # The Gateway validates Bearer auth; ingress never embeds or supplies its Secret.
    location = /health/ready {
        proxy_pass $gateway_health;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie '';
    }
    location = /metrics {
        proxy_pass $gateway_health;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie '';
    }
    location / { return 404; }
}
