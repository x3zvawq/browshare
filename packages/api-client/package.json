{
  "name": "@browshare/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "generate": "openapi-typescript ../../apps/backend/openapi.json -o src/generated.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@browshare/contracts": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
