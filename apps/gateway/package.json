{
  "name": "@browshare/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "browshare-gateway": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts --clean",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@browshare/common": "workspace:*",
    "@browshare/config": "workspace:*",
    "@browshare/contracts": "workspace:*",
    "typebox": "1.3.25"
  }
}
