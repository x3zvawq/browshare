{
  "name": "@browshare/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "browshare-worker": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts src/profile-chrome-supervisor.mjs --format esm --dts --clean",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@browshare/common": "workspace:*",
    "@browshare/config": "workspace:*",
    "@browshare/contracts": "workspace:*",
    "@browshare/navigation-policy": "workspace:*",
    "proxy-chain": "3.0.0",
    "typebox": "1.3.25",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
