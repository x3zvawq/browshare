BROWSHARE_WORKER_NAME=local-worker
BROWSHARE_BACKEND_URL=https://browshare.example.com
BROWSHARE_WORKER_IDENTITY_DIRECTORY=/var/lib/browshare/identity
BROWSHARE_WORKER_ENROLLMENT_TOKEN_FILE=/run/secrets/worker_enrollment_token
BROWSHARE_WORKER_ENROLLMENT_TIMEOUT_MS=15000
# Set only while applying an administrator-issued rotation token to an existing identity.
# BROWSHARE_WORKER_CREDENTIAL_ROTATION_TOKEN_FILE=/run/secrets/worker_credential_rotation_token
BROWSHARE_WORKER_CREDENTIAL_ROTATION_TIMEOUT_MS=15000
# BROWSHARE_WORKER_CONTROL_SERVER_CA_CERTIFICATE_FILE=/run/secrets/control_server_ca.pem
BROWSHARE_WORKER_CONTROL_HANDSHAKE_TIMEOUT_MS=10000
BROWSHARE_WORKER_CONTROL_RECONNECT_MIN_MS=1000
BROWSHARE_WORKER_CONTROL_RECONNECT_MAX_MS=30000
BROWSHARE_WORKER_HEALTH_HOST=127.0.0.1
BROWSHARE_WORKER_HEALTH_PORT=3410
BROWSHARE_WORKER_LOG_LEVEL=info
BROWSHARE_WORKER_CHROME_EXECUTABLE=/usr/bin/google-chrome-stable
BROWSHARE_EXPECTED_CHROME_VERSION=152.0.7977.75
BROWSHARE_EXPECTED_REMOTE_TAB_CORE_VERSION=0.1.20
BROWSHARE_EXPECTED_EXTENSION_VERSION=0.1.20
BROWSHARE_WORKER_PROFILE_STORAGE_DIRECTORY=/var/lib/browshare/profiles
BROWSHARE_WORKER_TEMPORARY_STORAGE_DIRECTORY=/var/lib/browshare/session-temp

# Enable only when the coordinated Remote Tab Core package, Chrome policy and signed Extension
# are installed in the Worker runtime.
BROWSHARE_REMOTE_TAB_ENABLED=true
BROWSHARE_REMOTE_TAB_EXTENSION_HOST=127.0.0.1
BROWSHARE_REMOTE_TAB_EXTENSION_PORT=9224
BROWSHARE_REMOTE_TAB_EXTENSION_ID=maelhflgchopoiadjbmmfpbopaeelgoj
BROWSHARE_REMOTE_TAB_EXTENSION_CRX_SHA256=replace-with-64-character-lowercase-crx-sha256
BROWSHARE_REMOTE_TAB_EXTENSION_RELEASE_DIRECTORY=/opt/browshare/extension-release
BROWSHARE_REMOTE_TAB_EXTENSION_UPDATE_PORT=9225
BROWSHARE_REMOTE_TAB_MANAGED_POLICY_PATH=/var/lib/browshare/chrome-policy/browshare-remote-tab.json
BROWSHARE_REMOTE_TAB_RUNTIME_SECRET_FILE=/run/secrets/remote_tab_runtime_secret
# The Worker CLI generates a fresh Extension generation on every process start.
BROWSHARE_REMOTE_TAB_EXTENSION_TIMEOUT_MS=15000

# Disk admission thresholds: max(bytes, filesystem total * percent / 100), per volume.
# LOW blocks new Profile/Session/import; CRITICAL also blocks new file transfers.
BROWSHARE_WORKER_LOW_DISK_BYTES=5368709120
BROWSHARE_WORKER_LOW_DISK_PERCENT=10
BROWSHARE_WORKER_CRITICAL_DISK_BYTES=1073741824
BROWSHARE_WORKER_CRITICAL_DISK_PERCENT=3
