{
  "name": "@browshare/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "browshare-backend": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts src/openapi.ts --format esm --dts --clean",
    "dev": "tsx watch src/cli.ts",
    "generate:openapi": "node dist/openapi.mjs",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@browshare/common": "workspace:*",
    "@browshare/config": "workspace:*",
    "@browshare/contracts": "workspace:*",
    "@browshare/database": "workspace:*",
    "@browshare/navigation-policy": "workspace:*",
    "@fastify/ajv-compiler": "4.0.6",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@peculiar/x509": "2.1.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "reflect-metadata": "0.2.2",
    "typebox": "1.3.25",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
