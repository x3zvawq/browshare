BROWSHARE_BACKEND_HOST=127.0.0.1
BROWSHARE_BACKEND_PORT=3400
BROWSHARE_BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BROWSHARE_BACKEND_LOG_LEVEL=info
BROWSHARE_BACKEND_DOCS_ENABLED=true
DATABASE_URL=postgresql://browshare:replace-me@127.0.0.1:5432/browshare
# DATABASE_URL_FILE=/run/secrets/database_url
BROWSHARE_SESSION_SECRET=replace-with-at-least-32-random-characters
# BROWSHARE_SESSION_SECRET_FILE=/run/secrets/browshare_session_secret
BROWSHARE_COOKIE_SECURE=true
# BROWSHARE_GATEWAYS_JSON_FILE=/run/secrets/gateways.json
BROWSHARE_WORKER_CONTROL_URL=wss://browshare.example.com/api/v1/worker-control
BROWSHARE_WORKER_CONTROL_HOST=127.0.0.1
BROWSHARE_WORKER_CONTROL_PORT=3443
BROWSHARE_WORKER_CONTROL_TLS_CERTIFICATE_FILE=/run/secrets/worker_control_tls_certificate.pem
BROWSHARE_WORKER_CONTROL_TLS_PRIVATE_KEY_FILE=/run/secrets/worker_control_tls_private_key.pem
BROWSHARE_WORKER_HELLO_TIMEOUT_MS=10000
BROWSHARE_WORKER_HEARTBEAT_INTERVAL_MS=10000
BROWSHARE_WORKER_OFFLINE_AFTER_MS=30000
BROWSHARE_WORKER_COMMAND_ACK_TIMEOUT_MS=3000
BROWSHARE_WORKER_COMMAND_RESULT_TIMEOUT_MS=60000
BROWSHARE_PROFILE_RUNTIME_COMMAND_TIMEOUT_MS=120000
BROWSHARE_WORKER_COMMAND_MAX_ATTEMPTS=3
BROWSHARE_WORKER_CA_CERTIFICATE_FILE=/run/secrets/worker_ca_certificate.pem
BROWSHARE_WORKER_CA_PRIVATE_KEY_FILE=/run/secrets/worker_ca_private_key.pem
BROWSHARE_WORKER_CERTIFICATE_VALIDITY_DAYS=90
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-10-characters
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
